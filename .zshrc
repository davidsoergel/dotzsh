source ~/.zsh/zshrc/detect-os
source ~/.zsh/zshrc/options
source ~/.zsh/zshrc/history
source ~/.zsh/zshrc/prompt
source ~/.zsh/zshrc/completions

source ~/.zsh/zshrc/prowl
source ~/.zsh/zshrc/handy
source ~/.zsh/zshrc/aliases
source ~/.zsh/zshrc/sshaliases
source ~/.zsh/zshrc/sshagent
source ~/.zsh/zshrc/gcloud
source ~/.zsh/zshrc/fnm

# local customizations
source ~/.zshrc.local

