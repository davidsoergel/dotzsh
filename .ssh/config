# Host *
# ForwardAgent yes
# don't do this; too dangerous


Host *
	ForwardX11 no
	ServerAliveInterval 60
	AddKeysToAgent yes
	UseKeychain yes

Host *.davidsoergel.com
	User soergel
	LocalForward 52698 localhost:52698
	ForwardAgent yes

Host lorax
	HostName lorax.org
	User lorax
	LocalForward 52698 localhost:52698
	ForwardAgent yes
    
Host loraxroot
    HostName lorax.org
    User ec2-user
    
Host ns1
    HostName 109.123.126.143
    KexAlgorithms +diffie-hellman-group14-sha1,diffie-hellman-group1-sha1
    # HostKeyAlgorithms +ssh-dss
    PubkeyAcceptedAlgorithms +ssh-rsa

Host ns1-tinydns
    HostName 109.123.126.143
    KexAlgorithms +diffie-hellman-group14-sha1,diffie-hellman-group1-sha1
    # HostKeyAlgorithms +ssh-dss
    PubkeyAcceptedAlgorithms +ssh-rsa
    #HostName 199.195.141.75
    User tinydns
    IdentityFile ~/.ssh/id_rsa.loraxns

Host ns2-tinydns
    HostName 104.131.92.41
    User tinydns
    IdentityFile ~/.ssh/id_rsa.loraxns
    PubkeyAcceptedAlgorithms +ssh-rsa
    
Host lorax-mosshe
    HostName lorax.org
    User mosshe
    IdentityFile ~/.ssh/id_rsa.mosshe

Host ns1-mosshe
    HostName 109.123.126.143
    KexAlgorithms +diffie-hellman-group14-sha1,diffie-hellman-group1-sha1
    # HostKeyAlgorithms +ssh-dss
    PubkeyAcceptedAlgorithms +ssh-rsa
    #HostName 199.195.141.75
    User mosshe
    IdentityFile ~/.ssh/id_rsa.mosshe

Host ns2-mosshe
    HostName 104.131.92.41
    User mosshe
    IdentityFile ~/.ssh/id_rsa.mosshe
    PubkeyAcceptedAlgorithms +ssh-rsa


Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519.github


