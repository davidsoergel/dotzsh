# this must be run via source or . so that the environment variable settings will work

# Propagate SSH environment variables from tmux into the current shell.
# Useful after reattaching to a tmux session with a new SSH agent.
if [ -n "$TMUX" ]; then
    tmux show-environment | grep -E '^SSH' | while read line; do
        var_name=${line%%=*}
        var_value=${line#*=}
        export ${var_name}="${var_value}"
    done
fi
