function laststatus { return $? }

urlencode() {
    setopt localoptions extendedglob
    input=( ${(s::)1} )
    print ${(j::)input/(#b)([^A-Za-z0-9_.\!~*\'\(\)-])/%${(l:2::0:)$(([##16]#match))}}
}

prowl() {
    if laststatus; then result=OK; else result=ERROR; fi
    description=$(tail -10 <&0)
    descriptionu=$(urlencode "$description")
    host=$(hostname)
    curl -s "https://prowlapp.com/publicapi/add?apikey=$PROWLKEY&application=$host&event=$1%20%3A%20$result&description=$descriptionu&priority=$2" > /dev/null
}
